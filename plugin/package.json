{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "opencode-ctx-manager",
    "version": "0.1.0",
    "type": "module",
    "description": "Advanced context manager for OpenCode with importance-based pruning, interconnectedness tracking, and ML-powered session recording",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./tui": {
            "types": "./dist/tui.d.ts",
            "import": "./tui.tsx"
        }
    },
    "scripts": {
        "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
        "build": "npm run clean && tsup && tsc --emitDeclarationOnly",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "dev": "opencode plugin dev",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "keywords": [
        "opencode",
        "opencode-plugin",
        "context",
        "management",
        "importance",
        "pruning",
        "session",
        "machine-learning"
    ],
    "license": "MIT",
    "peerDependencies": {
        "@opencode-ai/plugin": ">=1.4.3"
    },
    "dependencies": {
        "@anthropic-ai/tokenizer": "^0.0.4",
        "@opencode-ai/sdk": "^1.4.3",
        "@opentui/core": "^0.4.5",
        "@opentui/solid": "^0.4.5",
        "jsonc-parser": "^3.3.1",
        "solid-js": "^1.9.12"
    },
    "devDependencies": {
        "@opencode-ai/plugin": "^1.4.3",
        "@types/node": "^25.5.0",
        "prettier": "^3.8.1",
        "tsup": "^8.5.1",
        "tsx": "^4.21.0",
        "typescript": "^6.0.2",
        "vitest": "^5.0.0"
    },
    "files": [
        "dist/",
        "lib/",
        "tui.tsx",
        "README.md"
    ],
    "allowScripts": {
        "esbuild@0.27.7": true,
        "esbuild@0.28.2": true,
        "msgpackr-extract@3.0.4": true
    }
}
